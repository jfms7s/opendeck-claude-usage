{
	"Name": "Claude Usage",
	"Author": "jfms7s",
	"Version": "0.5.0",
	"Category": "Claude",
	"Icon": "icons/icon",
	"OS": [{ "Platform": "linux" }],
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "opendeck-claude-usage-x86_64-unknown-linux-gnu",
		"aarch64-unknown-linux-gnu": "opendeck-claude-usage-aarch64-unknown-linux-gnu"
	},
	"CodePathLin": "opendeck-claude-usage-x86_64-unknown-linux-gnu",
	"Actions": [
		{
			"UUID": "com.jfms7s.claudeusage.usagegauge",
			"Name": "Usage Gauge",
			"Icon": "icons/icon",
			"Tooltip": "Shows Claude session/weekly/monthly usage and time until reset",
			"Controllers": ["Encoder", "Keypad"],
			"PropertyInspectorPath": "propertyInspector/index.html",
			"States": [{ "Image": "icons/actionDefaultImage" }],
			"Encoder": {
				"layout": "layouts/usage.json"
			}
		},
		{
			"UUID": "com.jfms7s.claudeusage.peakclock",
			"Name": "Peak Clock",
			"Icon": "icons/icon",
			"Tooltip": "Shows a 24h clock with Claude's peak hours marked, whether it's currently peak or off-peak, and time until the next transition",
			"Controllers": ["Keypad"],
			"PropertyInspectorPath": "propertyInspector/peakclock.html",
			"States": [{ "Image": "icons/actionDefaultImage" }]
		},
		{
			"UUID": "com.jfms7s.claudeusage.metrictile",
			"Name": "Metric Tile",
			"Icon": "icons/icon",
			"Tooltip": "Shows total Claude Code tokens or estimated cost, parsed from local transcript logs, for today/7 days/the current session",
			"Controllers": ["Keypad"],
			"PropertyInspectorPath": "propertyInspector/metrictile.html",
			"States": [{ "Image": "icons/actionDefaultImage" }]
		}
	]
}
